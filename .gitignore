# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Trained checkpoints (reproducible per code, not worth tracking)
*/checkpoints/
projects/**/checkpoints/

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Python venv
venv/
.venv/
env/

# Build / dist
build/
dist/
*.egg-info/

# Logs / tmp (we log separately in experiments_log/)
*.log

# Don't track binary checkpoints but DO track small JSONs we generate
*.pt
*.bin
*.pkl

# Temporary scratch files from background runs
_*.bat
_*.pid
_*.txt


# LaTeX aux/out artefacts (committed PDFs are kept, intermediates are not).
*.aux
*.out
*.toc
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
